{
  "name": "component-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm && husky install",
    "build:event-bus-path": "pnpm --filter @component-gallery/build-event-bus-path build",
    "build:copy": "pnpm --filter @component-gallery/build-copy build",
    "build:theme-chalk": "pnpm --filter @component-gallery/theme-chalk --stream build",
    "build:packages": "pnpm --filter @component-gallery/build-full packages",
    "build:full-components": "pnpm --filter @component-gallery/build-full build",
    "lint:style": "stylelint \"packages/components/**/*.{css,scss,vue}\" --fix",
    "playground": "pnpm --filter @component-gallery/theme-chalk --parallel build && pnpm --filter @component-gallery/playground dev",
    "docs:genDocsRoute": "pnpm --filter @component-gallery/docs build:route",
    "comp-archive": "pnpm --filter @component-gallery/build-archive-upload archive common-comp-tree common-comp-tree-recorder",
    "docs:dev": "pnpm run docs:genDocsRoute && pnpm --filter @component-gallery/docs --parallel dev",
    "docs:build": "pnpm --filter @component-gallery/docs --parallel build",
    "docs:preview": "pnpm --filter @component-gallery/docs --parallel preview",
    "prepare-tinify-image": "pnpm --filter @component-gallery/tinify-images tinify",
    "graph": "pnpm build:event-bus-path && pnpm --filter @component-gallery/graph --parallel previewGraph"
  },
  "dependencies": {
    "@component-gallery/theme-chalk": "workspace:^",
    "@ct/icons-v2": "^1.2.26",
    "@ct/iframe-connect-sdk": "^1.0.18",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@riophae/vue-treeselect": "0.4.0",
    "@vue/composition-api": "^1.7.2",
    "@wchbrad/vue-easy-tree": "^1.0.12",
    "axios": "^1.6.5",
    "classnames": "^2.5.1",
    "ant-design-vue": "^3.2.20",
    "color-string": "^1.9.1",
    "crypto-js": "^4.2.0",
    "date-fns": "1.30.1",
    "dayjs": "^1.11.10",
    "echarts": "5.5.0",
    "element-resize-detector": "^1.2.4",
    "element-ui": "2.15.14",
    "file-saver": "^2.0.2",
    "g": "^2.0.1",
    "g711": "^1.0.1",
    "immer": "^10.0.3",
    "jquery": "^3.7.1",
    "jsts": "2.3.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "marked": "^14.1.2",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "path-browserify": "^1.0.1",
    "pinyin-pro": "^3.20.4",
    "uuid": "^10.0.0",
